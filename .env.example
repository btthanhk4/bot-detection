BOT_ADMIN_TOKEN=replace-with-a-long-random-admin-token
BOT_READ_TOKEN=replace-with-a-long-random-read-token
BOT_CORS_ORIGINS=http://152.42.205.62
BOT_MIN_MOUSE_POINTS_FOR_BOT=25
BOT_DECISION_THRESHOLD=0.96
BOT_SUSPECT_THRESHOLD=0.45
BOT_DATA_RETENTION_DAYS=30
# Opt in only on authorized pilot traffic; raw snapshots include browsing data.
BOT_CAPTURE_ENABLED=false
BOT_CAPTURE_RETENTION_DAYS=7
# Phone/tablet swipe and tap geometry for training the touch model (no page content, no IP).
BOT_TOUCH_CAPTURE=true
BOT_TOUCH_RETENTION_DAYS=180
MONGO_URI=mongodb://silkmoon-mongodb:27017
MONGO_DB=bot_detection
# Signs dashboard login cookies (openssl rand -hex 32). Keep it stable across restarts.
BOT_SESSION_SECRET=replace-with-a-long-random-secret
# Exact page origins allowed to post telemetry (empty = any).
BOT_TELEMETRY_ORIGINS=http://152.42.205.62
# minimal = anonymous /detect callers get only the verdict, not scores or evidence.
BOT_DETECT_RESPONSE=minimal
