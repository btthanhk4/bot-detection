# Copy to .env next to docker-compose.yml on the API host. Compose substitutes these
# into the container environment; a variable left unset uses the default written in
# docker-compose.yml.
BOT_ADMIN_TOKEN=replace-with-a-long-random-admin-token
BOT_READ_TOKEN=replace-with-a-long-random-read-token
# Signs dashboard login cookies (openssl rand -hex 32). Keep it stable across restarts.
BOT_SESSION_SECRET=replace-with-a-long-random-secret
BOT_SESSION_TTL_HOURS=12

# Website origins allowed to call the API from a browser (comma-separated).
BOT_CORS_ORIGINS=https://silkmoon.datacat.io.vn
# Extra origins allowed to post telemetry besides the websites registered on the
# dashboard (empty = registered websites only, or any origin while none are registered).
BOT_TELEMETRY_ORIGINS=
# Public base URL of this API, used in the install snippet shown on the dashboard.
BOT_PUBLIC_API_URL=https://api.datacat.io.vn
# minimal = anonymous /detect callers get only the verdict, not scores or evidence.
BOT_DETECT_RESPONSE=minimal

# Decision thresholds. docker-compose.yml pins these values, so they only take effect
# when the API runs outside Compose (uvicorn api_service.main:app).
BOT_MIN_MOUSE_POINTS_FOR_BOT=25
BOT_DECISION_THRESHOLD=0.96
BOT_SUSPECT_THRESHOLD=0.45

BOT_DATA_RETENTION_DAYS=30
# Opt in only on authorized pilot traffic; raw snapshots include browsing data.
BOT_CAPTURE_ENABLED=false
BOT_CAPTURE_RETENTION_DAYS=7
# Phone/tablet swipe and tap geometry for training the touch model (no page content, no IP).
BOT_TOUCH_CAPTURE=true
BOT_TOUCH_CAPTURE_SITES=silkmoon
BOT_TOUCH_RETENTION_DAYS=180
# Monthly refresh of the offline DB-IP Lite database into the volume.
BOT_GEOIP_AUTO_UPDATE=true

# Optional SilkMoon gateway (deploy/silkmoon-gateway). Empty disables both.
BOT_GATEWAY_SECRET=
BOT_PAGEVIEW_HOSTS=

MONGO_URI=mongodb://silkmoon-mongodb:27017
MONGO_DB=bot_detection
