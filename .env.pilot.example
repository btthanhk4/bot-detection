# Copy to .env.pilot on the API host; never put these tokens in the website.
BOT_ADMIN_TOKEN=replace-with-a-long-random-admin-token
BOT_READ_TOKEN=replace-with-a-different-long-random-read-token
BOT_CORS_ORIGINS=http://localhost:8080
BOT_PILOT_PORT=8000
BOT_CAPTURE_RETENTION_DAYS=7
BOT_DATA_RETENTION_DAYS=30
BOT_RATE_LIMIT_PER_MINUTE=240
BOT_SESSION_SECRET=replace-with-a-long-random-secret
